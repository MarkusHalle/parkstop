{
  "name": "parkstop",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan --port 5443 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --mode lan --port 5443 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:deps": "node scripts/check-deps.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "build:districts": "node scripts/build-districts.mjs",
    "build:capital-roads": "node scripts/build-capital-roads.mjs",
    "build:capital-display": "node scripts/build-capital-display.mjs",
    "check:capital-tiles": "node scripts/build-capital-display.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/point-to-line-distance": "^7.4.0",
    "exifr": "^7.1.3",
    "idb": "^8.0.4",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@turf/length": "^7.4.0",
    "@turf/line-slice": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1"
  }
}
